(ns kotoba.abi.contract
  "Small, dependency-free constants shared by generated ABI consumers."
  {:kotoba/export #?(:kotoba [ambient-wasi? cancellation-required? capability-id capability-import-name cid? component-target component-target-v2 component-world component-world-v2 profile? typed-capability-wit-v3 typed-capability-world-v3 wasi-version world-wit world-wit-v2]
                     :default [ability-keys admission-keys ambient-wasi? approval-keys cancellation-required? capability-id capability-import-name capability-import-names capability-imports capability-lease-keys cid? component-authority-envelope-keys component-authority-event-keys component-authority-signing-payload component-import-key component-profiles component-target component-target-v2 component-world component-world-v2 conformance-result exact-import-grant-provider-sets? execution-identity-keys plan-keys policy-decision-keys portable-execution-v1-vectors profile? required-budget-keys stream-contract typed-capability-ids typed-capability-operation typed-capability-operations typed-capability-wit-v3 typed-capability-world-v3 valid-ability? valid-approval? valid-capability-lease? valid-component-authority-envelope? valid-component-authority-event? valid-execution-identity? valid-plan? valid-policy-decision? valid-stream-limits? wasi-version world-wit world-wit-v2])}
  (:require [kotoba.abi.wit-data :as wit-data]))

;; ── the Kotoba reading of this file ─────────────────────────────────────────
;; `#?(:kotoba A :default B)`: the Kotoba reader takes A, the JVM and
;; ClojureScript readers take B, so every host body below is what it was.
;; The Kotoba surface is the part of the contract that is scalars and text: the
;; world names and versions (a constant is a zero-argument function there, since
;; an :export names a function), the capability-id -> import-name table, the
;; two WIT renderers, `cid?` and the profile predicates. What the hosts throw
;; for an unknown capability id a Kotoba function traps (`assert`). The
;; descriptors and their validators (`valid-plan?`, `valid-approval?`, ...,
;; `typed-capability-operations`, `portable-execution-v1-vectors`) are EDN maps
;; whose shape is only known at run time and exist on the hosts only.

#?(:kotoba
   (defn- import-name
     "The WIT import name of capability id ID, or \"\"."
     [id :i64] :string
     (cond (= id 1) "aiueos-identity-sign" (= id 2) "aiueos-identity-verify"
           (= id 3) "aiueos-hash-sha256" (= id 4) "aiueos-http-post"
           (= id 5) "aiueos-log-read" (= id 6) "aiueos-log-append"
           (= id 7) "aiueos-clock-now" (= id 8) "aiueos-state-transact"
           (= id 9) "aiueos-ui-commit" (= id 10) "aiueos-ui-next-event"
           (= id 11) "aiueos-llm-generate" (= id 12) "aiueos-storage-transact"
           (= id 13) "aiueos-http-get-stream" (= id 14) "aiueos-object-get-stream"
           (= id 15) "aiueos-object-put-block" (= id 16) "aiueos-object-compare-and-set-ref"
           (= id 17) "aiueos-http-accept" (= id 18) "aiueos-http-reply"
           :else "")))

#?(:kotoba
(defn component-world [] :string "kotoba:app/kotoba-app@0.1.0"))

#?(:kotoba nil
   :default
(def component-world "kotoba:app/kotoba-app@0.1.0"))
